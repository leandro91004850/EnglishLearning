# Modelo dos dados de acesso ao PostgreSQL do Legendas YT (os mesmos do app Python legendas-yt).
# No app, o jeito mais fácil é preencher em ⋮ › Banco de dados: ele grava o .env na pasta
# privada do app, no aparelho.
# Para o diagnóstico sem abrir o app:  dart run bin/diagnostico.dart
# (lê um arquivo .env nesta pasta; o .env fica fora do git porque tem a senha).
# Se o banco ainda não existir, o app tenta criá-lo; as tabelas ele cria sozinho.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legendas_yt
DB_USER=postgres
DB_PASSWORD=
# Servidor na nuvem que exige conexão segura:
# DB_SSLMODE=require
